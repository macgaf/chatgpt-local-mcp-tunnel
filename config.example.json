{
  "root": "~",
  "default_policy": "allow",
  "allow": [
    "Projects/**",
    "Documents/**",
    "Downloads/**",
    "Desktop/**",
    "AI-Workspace/**"
  ],
  "force_allow": [
    ".env.example",
    "**/.env.example",
    ".env.sample",
    "**/.env.sample",
    ".env.template",
    "**/.env.template"
  ],
  "deny": [
    ".ssh",
    ".ssh/**",
    ".gnupg",
    ".gnupg/**",
    ".aws",
    ".aws/**",
    ".azure",
    ".azure/**",
    ".kube",
    ".kube/**",
    ".docker/config.json",
    ".git-credentials",
    ".netrc",
    ".npmrc",
    ".pypirc",
    "Library/Keychains",
    "Library/Keychains/**",
    "Library/**/Cookies*",
    "Library/**/Login Data*",
    ".env",
    "**/.env",
    ".env.*",
    "**/.env.*",
    "*.pem",
    "**/*.pem",
    "*.key",
    "**/*.key",
    "*.p12",
    "**/*.p12",
    "*.pfx",
    "**/*.pfx",
    "credentials*",
    "**/credentials*",
    "secrets",
    "secrets/**",
    "**/secrets",
    "**/secrets/**",
    ".Trash",
    ".Trash/**",
    "Library/Caches",
    "Library/Caches/**",
    "node_modules/**",
    "**/node_modules/**",
    ".venv/**",
    "**/.venv/**",
    "__pycache__/**",
    "**/__pycache__/**"
  ],
  "max_file_size": 8388608,
  "max_text_output_bytes": 524288,
  "max_directory_entries": 500,
  "max_search_files": 5000,
  "max_search_results": 200,
  "binary_policy": "metadata_only"
}
